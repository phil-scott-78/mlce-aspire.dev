@inherits LayoutComponentBase
@inject ITableOfContentService TableOfContentService
@inject NavigationManager NavigationManager
@inject ContentEngineOptions Options

<div class="dark:scheme-dark min-h-screen bg-white dark:bg-base-900 text-base-950 dark:text-base-100">
    @* Mobile overlay *@
    <div id="mobile-overlay" class="fixed inset-0 bg-black/50 backdrop-blur z-30 lg:hidden aria-hidden:hidden" aria-hidden="true"></div>

    <div class="flex min-h-screen">
        @* Sidebar *@
        <aside id="nav-sidebar" data-expanded="false"
               class="transition-[margin] ease-in-out duration-300 -ml-72 data-[expanded=true]:ml-0 lg:ml-0 w-72 flex-none border-r border-base-300 dark:border-base-700 fixed lg:static z-40 h-full lg:h-auto bg-white dark:bg-base-900">
            <div class="sticky top-0 h-screen overflow-y-auto p-6">
                @* Logo *@
                <a href="/" class="flex items-center gap-2 mb-5">
                    <svg width="24" height="24" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3.5 30C1.57 30 0 28.43 0 26.5C0 25.871 0.166 25.259 0.48 24.729L8.818 10.287L8.852 10.236L12.968 3.099C13.593 2.019 14.754 1.349 16 1.349C17.246 1.349 18.407 2.019 19.031 3.098L31.531 24.749C31.833 25.258 31.999 25.87 31.999 26.499C31.999 28.429 30.429 29.999 28.499 29.999L3.5 30Z" fill="#512BD4"/>
                        <path d="M25.33 18H16.99L16 16.28L13.13 11.31C13 11.09 12.82 10.9 12.58 10.77C11.87 10.35 10.95 10.6 10.53 11.32L14.7 4.10001C14.96 3.65001 15.44 3.35001 16 3.35001C16.56 3.35001 17.04 3.65001 17.3 4.10001L21.45 11.29L21.46 11.31L21.48 11.34L25.33 18Z" fill="#7455DD"/>
                        <path d="M30 26.5C30 27.33 29.33 28 28.5 28H20.17C21 28 21.67 27.33 21.67 26.5C21.67 26.23 21.59 25.97 21.47 25.75L17.3 18.53L16.99 18H25.33L29.8 25.75C29.93 25.97 30 26.23 30 26.5Z" fill="#9780E5"/>
                        <path d="M21.67 26.5C21.67 27.33 21 28 20.17 28H11.83C12.66 28 13.33 27.33 13.33 26.5C13.33 26.23 13.26 25.97 13.13 25.75C13.13 25.74 13.12 25.73 13.11 25.72L11.79 23.57L8.82004 18.72C8.55004 18.28 8.07004 18 7.54004 18H16.99L17.3 18.53L17.427 18.75L21.47 25.75C21.59 25.97 21.67 26.23 21.67 26.5Z" fill="#B9AAEE"/>
                        <path d="M13.33 26.5C13.33 27.33 12.66 28 11.83 28H3.5C2.67 28 2 27.33 2 26.5C2 26.23 2.07 25.97 2.2 25.75L6.24 18.75C6.51 18.29 7.01 18 7.54 18C8.07 18 8.55 18.28 8.82 18.72L11.79 23.57L13.11 25.72C13.12 25.73 13.13 25.74 13.13 25.75C13.26 25.97 13.33 26.23 13.33 26.5Z" fill="#DCD5F6"/>
                        <path d="M16.99 18H7.53999C7.00999 18 6.50999 18.29 6.23999 18.75L6.66999 18L10.49 11.39L10.53 11.33V11.32C10.95 10.6 11.87 10.35 12.58 10.77C12.82 10.9 13 11.09 13.13 11.31L16 16.28L16.99 18Z" fill="#9780E5"/>
                    </svg>
                    <span class="font-display text-lg font-semibold tracking-tight">Aspire</span>
                </a>

                @* Section tabs *@
                <nav class="flex flex-col gap-0.5 mb-5 pb-5 border-b border-base-300 dark:border-base-700">
                    @foreach (var item in _sections)
                    {
                        var isActive = _currentSection == item.Path;
                        <a href="@item.Href"
                           class="@($"flex items-center gap-2 px-3 py-1.5 rounded-md text-sm font-medium transition-colors {(isActive ? "bg-primary-200/40 dark:bg-primary-500/20 text-primary-700 dark:text-primary-200" : "text-base-500 dark:text-base-400 hover:bg-base-200 dark:hover:bg-base-700 hover:text-base-950 dark:hover:text-white")}")">
                            @item.Label
                        </a>
                    }
                </nav>

                @* Section-specific table of contents *@
                @if (_toc != null)
                {
                    <AspireTocNavigation TableOfContents="_toc" HiddenSections="_hiddenSections" />
                }
            </div>
        </aside>

        @* Main content area *@
        <div class="flex-1 min-w-0">
            @* Header *@
            <header class="sticky top-0 z-25 h-14 backdrop-blur bg-white/90 dark:bg-base-900/90 border-b border-base-300 dark:border-base-700 backdrop-blur-sm">
                <nav class="mx-auto px-4 lg:px-8 max-w-5xl flex items-center h-full gap-4">
                    <button id="menu-toggle" aria-label="Toggle navigation" class="lg:hidden p-1 rounded hover:bg-base-200 dark:hover:bg-base-700">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                    <a href="/" class="lg:hidden flex items-center gap-2">
                        <svg width="20" height="20" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3.5 30C1.57 30 0 28.43 0 26.5C0 25.871 0.166 25.259 0.48 24.729L8.818 10.287L8.852 10.236L12.968 3.099C13.593 2.019 14.754 1.349 16 1.349C17.246 1.349 18.407 2.019 19.031 3.098L31.531 24.749C31.833 25.258 31.999 25.87 31.999 26.499C31.999 28.429 30.429 29.999 28.499 29.999L3.5 30Z" fill="#512BD4"/>
                            <path d="M25.33 18H16.99L16 16.28L13.13 11.31C13 11.09 12.82 10.9 12.58 10.77C11.87 10.35 10.95 10.6 10.53 11.32L14.7 4.10001C14.96 3.65001 15.44 3.35001 16 3.35001C16.56 3.35001 17.04 3.65001 17.3 4.10001L21.45 11.29L21.46 11.31L21.48 11.34L25.33 18Z" fill="#7455DD"/>
                            <path d="M30 26.5C30 27.33 29.33 28 28.5 28H20.17C21 28 21.67 27.33 21.67 26.5C21.67 26.23 21.59 25.97 21.47 25.75L17.3 18.53L16.99 18H25.33L29.8 25.75C29.93 25.97 30 26.23 30 26.5Z" fill="#9780E5"/>
                            <path d="M21.67 26.5C21.67 27.33 21 28 20.17 28H11.83C12.66 28 13.33 27.33 13.33 26.5C13.33 26.23 13.26 25.97 13.13 25.75C13.13 25.74 13.12 25.73 13.11 25.72L11.79 23.57L8.82004 18.72C8.55004 18.28 8.07004 18 7.54004 18H16.99L17.3 18.53L17.427 18.75L21.47 25.75C21.59 25.97 21.67 26.23 21.67 26.5Z" fill="#B9AAEE"/>
                            <path d="M13.33 26.5C13.33 27.33 12.66 28 11.83 28H3.5C2.67 28 2 27.33 2 26.5C2 26.23 2.07 25.97 2.2 25.75L6.24 18.75C6.51 18.29 7.01 18 7.54 18C8.07 18 8.55 18.28 8.82 18.72L11.79 23.57L13.11 25.72C13.12 25.73 13.13 25.74 13.13 25.75C13.26 25.97 13.33 26.23 13.33 26.5Z" fill="#DCD5F6"/>
                            <path d="M16.99 18H7.53999C7.00999 18 6.50999 18.29 6.23999 18.75L6.66999 18L10.49 11.39L10.53 11.33V11.32C10.95 10.6 11.87 10.35 12.58 10.77C12.82 10.9 13 11.09 13.13 11.31L16 16.28L16.99 18Z" fill="#9780E5"/>
                        </svg>
                        <span class="font-display text-sm font-semibold">Aspire</span>
                    </a>
                    <div class="flex-1">
                        <button type="button"
                                id="search-input"
                                class="w-8 md:w-32 lg:w-full m-0 max-w-xl h-8 transition-all pr-4 items-center gap-2 rounded-full bg-white dark:bg-base-950/5 pl-1 text-sm text-base-500 dark:text-base-400 ring-1 ring-base-950/10 hover:ring-base-950/20 md:flex dark:ring-white/10 dark:ring-inset dark:hover:ring-white/20">
                            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="h-6 w-6 stroke-current">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12.01 12a4.25 4.25 0 1 0-6.02-6 4.25 4.25 0 0 0 6.02 6Zm0 0 3.24 3.25"></path>
                            </svg>
                            <span class="hidden md:inline-block">Search</span>
                            <kbd class="hidden lg:inline-block ml-auto text-xs text-base-500 dark:text-base-400">
                                <kbd class="font-sans">Ctrl </kbd><kbd class="font-sans">K</kbd>
                            </kbd>
                        </button>
                    </div>
                    <button aria-label="Toggle dark mode" class="p-1.5 rounded hover:bg-base-200 dark:hover:bg-base-700" data-theme-toggle>
                        <svg class="dark:hidden w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="1.5">
                            <path d="M17 12C17 14.7614 14.7614 17 12 17C9.23858 17 7 14.7614 7 12C7 9.23858 9.23858 7 12 7C14.7614 7 17 9.23858 17 12Z" />
                            <path d="M11.9955 3H12.0045M11.9961 21H12.0051M18.3588 5.63599H18.3678M5.63409 18.364H5.64307M5.63409 5.63647H5.64307M18.3582 18.3645H18.3672M20.991 12.0006H21M3 12.0006H3.00898" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <svg class="hidden dark:block w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="1">
                            <path d="M21.5 14.0784C20.3003 14.7189 18.9301 15.0821 17.4751 15.0821C12.7491 15.0821 8.91792 11.2509 8.91792 6.52485C8.91792 5.06986 9.28105 3.69968 9.92163 2.5C5.66765 3.49698 2.5 7.31513 2.5 11.8731C2.5 17.1899 6.8101 21.5 12.1269 21.5C16.6849 21.5 20.503 18.3324 21.5 14.0784Z" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                    <a href="https://github.com/dotnet/aspire" aria-label="GitHub" class="p-1.5 rounded hover:bg-base-200 dark:hover:bg-base-700">
                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="1">
                            <path d="M10 20.5675C6.57143 21.7248 3.71429 20.5675 2 17" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M10 22V18.7579C10 18.1596 10.1839 17.6396 10.4804 17.1699C10.6838 16.8476 10.5445 16.3904 10.1771 16.2894C7.13394 15.4528 5 14.1077 5 9.64606C5 8.48611 5.38005 7.39556 6.04811 6.4464C6.21437 6.21018 6.29749 6.09208 6.31748 5.9851C6.33746 5.87813 6.30272 5.73852 6.23322 5.45932C5.95038 4.32292 5.96871 3.11619 6.39322 2.02823C6.39322 2.02823 7.27042 1.74242 9.26698 2.98969C9.72282 3.27447 9.95075 3.41686 10.1515 3.44871C10.3522 3.48056 10.6206 3.41384 11.1573 3.28041C11.8913 3.09795 12.6476 3 13.5 3C14.3524 3 15.1087 3.09795 15.8427 3.28041C16.3794 3.41384 16.6478 3.48056 16.8485 3.44871C17.0493 3.41686 17.2772 3.27447 17.733 2.98969C19.7296 1.74242 20.6068 2.02823 20.6068 2.02823C21.0313 3.11619 21.0496 4.32292 20.7668 5.45932C20.6973 5.73852 20.6625 5.87813 20.6825 5.9851C20.7025 6.09207 20.7856 6.21019 20.9519 6.4464C21.6199 7.39556 22 8.48611 22 9.64606C22 14.1077 19.8661 15.4528 16.8229 16.2894C16.4555 16.3904 16.3162 16.8476 16.5196 17.1699C16.8161 17.6396 17 18.1596 17 18.7579V22" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                </nav>
            </header>

            @* Page content *@
            <main class="mx-auto max-w-7xl">
                <div class="flex gap-8 xl:gap-12">
                    <article class="aspire-content flex-1 min-w-0 mt-6 lg:mt-8 mx-4 lg:mx-8 xl:mr-0 pb-16">
                        @Body
                    </article>
                    <div class="hidden xl:block sticky top-20 h-min max-h-[calc(100vh-6rem)] overflow-y-auto w-64 pt-8 text-sm">
                        <SectionOutlet SectionName="outline" />
                    </div>
                </div>
            </main>
        </div>
    </div>
</div>

@code {
    private ImmutableList<NavigationTreeItem>? _toc;
    private string _currentSection = "";

    private static readonly HashSet<string> _hiddenSections = ["Diagnostics", "404", "Aspire Support Policy"];

    private static readonly (string Label, string Path, string Href)[] _sections =
    [
        ("Docs", "docs", "/docs/"),
        ("Integrations", "integrations", "/integrations/"),
        ("Dashboard", "dashboard", "/dashboard/"),
        ("Deployment", "deployment", "/deployment/"),
        ("Reference", "reference", "/reference/"),
        ("Community", "community", "/community/"),
    ];

    protected override async Task OnInitializedAsync()
    {
        var path = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).AbsolutePath;

        // Determine current section from URL
        var segments = path.Trim('/').Split('/');
        _currentSection = segments.Length > 0 ? segments[0] : "";

        if (!string.IsNullOrEmpty(_currentSection))
        {
            var sectionToc = await TableOfContentService.GetNavigationTocAsync(path, _currentSection);
            // Unwrap the section container node to get its children directly
            _toc = sectionToc.Count > 0 ? sectionToc.First().Items.ToImmutableList() : sectionToc;
        }
        else
        {
            _toc = await TableOfContentService.GetNavigationTocAsync(path);
        }
    }
}
