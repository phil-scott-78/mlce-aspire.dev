<div class="relative pt-6 pb-2">
    <div class="absolute left-6 top-10 bottom-8 w-[3px] rounded-sm bg-gradient-to-b from-primary-500/60 via-primary-300/40 to-base-400/20" aria-hidden="true"></div>
    <ol class="list-none m-0 p-0 flex flex-col">
        @foreach (var step in Steps)
        {
            <li class="group grid grid-cols-[3rem_1fr] gap-4 py-4 relative z-10">
                <div class="flex items-center justify-center pt-3 relative z-50">
                    <div class="w-12 h-12 rounded-full grid place-items-center bg-base-100 dark:bg-base-900 border-2 border-primary-300 dark:border-primary-500 text-primary-500 transition-all group-hover:bg-base-200 dark:group-hover:bg-base-800 group-hover:border-primary-500 group-hover:scale-105">
                        <SvgIcon Name="@step.Icon" Size="24" />
                    </div>
                </div>
                <a href="@step.Href" class="block no-underline py-3 px-5 rounded-xl border border-transparent transition-all cursor-pointer group-hover:bg-primary-500/6 group-hover:border-primary-500/18 focus-visible:outline-2 focus-visible:outline-base-900 focus-visible:outline-offset-2">
                    <h3 class="m-0 mb-1 text-lg font-semibold text-base-900 dark:text-base-100 leading-tight">@step.Title</h3>
                    <p class="m-0 mb-2.5 text-sm leading-relaxed text-base-500 dark:text-base-400">@step.Description</p>
                    <span class="inline-flex items-center gap-1 text-[0.85rem] font-semibold text-primary-500 dark:text-primary-300 no-underline transition-[gap] group-hover:gap-2.5 group-hover:underline">
                        @(step.Label ?? "Learn more")
                        <SvgIcon Name="right-arrow" Size="14" />
                    </span>
                </a>
            </li>
        }
    </ol>
</div>

@code {
    [Parameter] public List<JourneyStep> Steps { get; set; } = [];
}
