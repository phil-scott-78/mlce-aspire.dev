<PageTitle>Aspire Deployment - Aspire</PageTitle>
<HeadContent>
    <meta name="description" content="Ship your Aspire applications to Azure, Docker, Kubernetes, and beyond — with confidence and consistency." />
</HeadContent>

<TopicHero
    Icon="rocket"
    Title="From dev to production,"
    Highlight="seamlessly."
    Subtitle="Generate deployment artifacts with aspire publish, then deploy anywhere — Azure, Docker, Kubernetes, or your own pipeline."
    Accent="orange"
    FloatingIcons="@(new[] { "cloud-download", "docker", "laptop", "config", "setting" })"
    PrimaryCta="@(("Deploy your first app", "/docs/get-started/deploy-first-app/"))"
    SecondaryCta="@(("Read deployment overview", "/deployment/overview/"))" />

<h2 class="text-2xl font-bold mt-10 mb-3 text-base-900 dark:text-base-100 pb-2 border-b border-base-200 dark:border-base-700">How deployment works</h2>
<p class="text-[0.95rem] leading-relaxed text-base-500 dark:text-base-400 mb-4 max-w-3xl [&_a]:text-primary-500 dark:[&_a]:text-primary-300">Aspire's deployment model is built on two complementary commands that keep your workflow clean, secure, and extensible.</p>

<QuickStartJourney Steps="@_deploymentSteps" />

<h2 class="text-2xl font-bold mt-10 mb-3 text-base-900 dark:text-base-100 pb-2 border-b border-base-200 dark:border-base-700">Deploy anywhere</h2>
<p class="text-[0.95rem] leading-relaxed text-base-500 dark:text-base-400 mb-4 max-w-3xl [&_a]:text-primary-500 dark:[&_a]:text-primary-300">Aspire is not locked to a single cloud. Your local dev topology translates directly to production infrastructure through hosting integrations.</p>

<CapabilityGrid Columns="2" Capabilities="@_deployTargets" />

<h2 class="text-2xl font-bold mt-10 mb-3 text-base-900 dark:text-base-100 pb-2 border-b border-base-200 dark:border-base-700">Key concepts</h2>

<FeatureShowcase Features="@_keyConcepts" />

<CTABanner
    Title="Ship with confidence"
    Description="Your local AppHost model is your deployment model. No configuration drift, no surprises — just consistent, repeatable deployments."
    PrimaryCta="@(("Deploy your first app", "/docs/get-started/deploy-first-app/"))"
    SecondaryCta="@(("Browse integrations", "/integrations/"))" />

<SectionNavigation Previous="@(("Dashboard", "/dashboard/"))" Next="@(("Reference", "/reference/"))" />

@code {
    private static readonly List<JourneyStep> _deploymentSteps =
    [
        new("terminal", "aspire publish", "Transforms your AppHost model into integration-specific artifacts — Docker Compose files, Kubernetes manifests, Bicep templates, and more. Secrets remain as parameterized placeholders.", "/reference/cli/commands/aspire-publish/", "View publish reference"),
        new("rocket", "aspire deploy", "Resolves parameters, applies configuration, and executes the deployment to your target environment. Works with Azure Container Apps, Kubernetes, and more.", "/reference/cli/commands/aspire-deploy/", "View deploy reference"),
        new("setting", "Customize your pipeline", "Build custom deployment pipelines that plug into the same model. Use CI/CD variable injection, scripts, or your own toolchain to resolve parameters and apply changes.", "/deployment/custom-deployments/", "Custom pipelines"),
    ];

    private static readonly List<CapabilityItem> _deployTargets =
    [
        new("cloud-download", "Azure Container Apps", "Deploy directly to Azure Container Apps with a single command. Aspire provisions infrastructure, configures networking, and resolves secrets automatically.", "/deployment/azure/aca-deployment-aspire-cli/"),
        new("docker", "Docker Compose", "Generate production-ready Docker Compose files with parameterized environment variables. Perfect for self-hosted and on-premises scenarios.", "/deployment/docker-compose/"),
        new("config", "Kubernetes", "Produce Kubernetes Helm charts that reflect your AppHost model. Deploy to any K8s cluster with your existing toolchain.", "/deployment/kubernetes/"),
        new("puzzle", "Custom integrations", "Build your own publish or deploy integrations. The system is fully extensible — any hosting integration can participate in the deployment model.", "/deployment/custom-deployments/"),
    ];

    private static readonly List<FeatureItem> _keyConcepts =
    [
        new("json", "Parameter placeholders", "Published assets use placeholders for secrets and environment-specific values. Shape stays consistent, values are injected at deploy time.", "/deployment/overview/", "Learn about parameters", "blue"),
        new("bars", "State caching", "Speed up repeated deployments with state caching. Aspire tracks what has changed and only updates what it needs to.", "/deployment/deployment-state-caching/", "Explore caching", "green"),
        new("warning", "Azure security", "Follow best practices for securing your Azure deployments — managed identities, key vaults, network isolation, and more.", "/deployment/azure/azure-security-best-practices/", "Security best practices", "orange"),
    ];
}
