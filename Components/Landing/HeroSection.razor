<section class="hero-section relative overflow-hidden py-12 px-8 sm:py-8 sm:px-5 rounded-xl mb-8 border border-primary-300/24 dark:border-primary-300/25">
    <div class="hero-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="relative z-10 inline-flex items-center justify-center w-16 h-16 rounded-xl mb-5 ml-4 bg-primary-500/18 dark:bg-primary-500/18 border-2 border-primary-500/35" aria-hidden="true">
        <svg width="36" height="36" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3.5 30C1.57 30 0 28.43 0 26.5C0 25.871 0.166 25.259 0.48 24.729L8.818 10.287L8.852 10.236L12.968 3.099C13.593 2.019 14.754 1.349 16 1.349C17.246 1.349 18.407 2.019 19.031 3.098L31.531 24.749C31.833 25.258 31.999 25.87 31.999 26.499C31.999 28.429 30.429 29.999 28.499 29.999L3.5 30Z" fill="#512BD4"/>
            <path d="M25.33 18H16.99L16 16.28L13.13 11.31C13 11.09 12.82 10.9 12.58 10.77C11.87 10.35 10.95 10.6 10.53 11.32L14.7 4.10001C14.96 3.65001 15.44 3.35001 16 3.35001C16.56 3.35001 17.04 3.65001 17.3 4.10001L21.45 11.29L21.46 11.31L21.48 11.34L25.33 18Z" fill="#7455DD"/>
            <path d="M30 26.5C30 27.33 29.33 28 28.5 28H20.17C21 28 21.67 27.33 21.67 26.5C21.67 26.23 21.59 25.97 21.47 25.75L17.3 18.53L16.99 18H25.33L29.8 25.75C29.93 25.97 30 26.23 30 26.5Z" fill="#9780E5"/>
            <path d="M21.67 26.5C21.67 27.33 21 28 20.17 28H11.83C12.66 28 13.33 27.33 13.33 26.5C13.33 26.23 13.26 25.97 13.13 25.75C13.13 25.74 13.12 25.73 13.11 25.72L11.79 23.57L8.82004 18.72C8.55004 18.28 8.07004 18 7.54004 18H16.99L17.3 18.53L17.427 18.75L21.47 25.75C21.59 25.97 21.67 26.23 21.67 26.5Z" fill="#B9AAEE"/>
            <path d="M13.33 26.5C13.33 27.33 12.66 28 11.83 28H3.5C2.67 28 2 27.33 2 26.5C2 26.23 2.07 25.97 2.2 25.75L6.24 18.75C6.51 18.29 7.01 18 7.54 18C8.07 18 8.55 18.28 8.82 18.72L11.79 23.57L13.11 25.72C13.12 25.73 13.13 25.74 13.13 25.75C13.26 25.97 13.33 26.23 13.33 26.5Z" fill="#DCD5F6"/>
            <path d="M16.99 18H7.53999C7.00999 18 6.50999 18.29 6.23999 18.75L6.66999 18L10.49 11.39L10.53 11.33V11.32C10.95 10.6 11.87 10.35 12.58 10.77C12.82 10.9 13 11.09 13.13 11.31L16 16.28L16.99 18Z" fill="#9780E5"/>
        </svg>
    </div>
    <div class="relative z-10 max-w-2xl pl-4 sm:pl-2">
        <h1 class="text-[clamp(1.75rem,4vw,2.75rem)] font-bold leading-[1.15] tracking-tight m-0 mb-4 text-base-900 dark:text-base-100">
            @Title
            @if (!string.IsNullOrEmpty(Highlight))
            {
                <span>&nbsp;</span><span class="bg-gradient-to-r from-primary-700 via-primary-500 to-primary-300 dark:from-primary-500 dark:via-primary-300 dark:to-primary-200 bg-clip-text text-transparent">@Highlight</span>
            }
        </h1>
        <p class="text-[clamp(1rem,2vw,1.2rem)] leading-relaxed text-base-500 dark:text-base-400 m-0 mb-7 max-w-xl">@Subtitle</p>
        @if (PrimaryCta != null || SecondaryCta != null)
        {
            <div class="flex flex-wrap gap-3 items-center">
                @if (PrimaryCta != null)
                {
                    <a href="@PrimaryCta.Value.Href" class="inline-flex gap-2 items-center py-2.5 px-6 rounded-lg font-semibold text-[0.95rem] no-underline transition-all whitespace-nowrap cursor-pointer bg-primary-500 text-white hover:bg-primary-700 hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-base-900 focus-visible:outline-offset-2">
                        @PrimaryCta.Value.Label
                        <SvgIcon Name="right-arrow" Size="20" />
                    </a>
                }
                @if (SecondaryCta != null)
                {
                    <a href="@SecondaryCta.Value.Href" class="inline-flex gap-2 items-center py-2.5 px-6 rounded-lg font-semibold text-[0.95rem] no-underline transition-all whitespace-nowrap cursor-pointer bg-primary-500/12 text-base-900 dark:text-base-100 border border-primary-500/30 hover:bg-primary-500/20 hover:border-primary-500/50 focus-visible:outline-2 focus-visible:outline-base-900 focus-visible:outline-offset-2">
                        @SecondaryCta.Value.Label
                    </a>
                }
            </div>
        }
    </div>
    <div class="absolute top-0 bottom-0 right-0 w-[40%] sm:w-1/2 sm:-right-[10%] pointer-events-none overflow-hidden" aria-hidden="true">
        <span class="floating-icon absolute inline-flex items-center justify-center opacity-10 text-primary-500 blur-[0.5px] motion-reduce:animate-none motion-reduce:opacity-[0.08]" style="top: 15%; right: 20%; font-size: 1.8rem; animation-delay: 0.5s; animation-duration: 9s;">
            <SvgIcon Name="open-book" Size="24" />
        </span>
        <span class="floating-icon absolute inline-flex items-center justify-center opacity-10 text-primary-500 blur-[0.5px] motion-reduce:animate-none motion-reduce:opacity-[0.08]" style="top: 55%; right: 65%; font-size: 2rem; animation-delay: 2.1s; animation-duration: 11s;">
            <SvgIcon Name="puzzle" Size="24" />
        </span>
        <span class="floating-icon absolute inline-flex items-center justify-center opacity-10 text-primary-500 blur-[0.5px] motion-reduce:animate-none motion-reduce:opacity-[0.08]" style="top: 30%; right: 50%; font-size: 1.6rem; animation-delay: 4s; animation-duration: 10s;">
            <SvgIcon Name="rocket" Size="24" />
        </span>
        <span class="floating-icon absolute inline-flex items-center justify-center opacity-10 text-primary-500 blur-[0.5px] motion-reduce:animate-none motion-reduce:opacity-[0.08]" style="top: 70%; right: 25%; font-size: 1.9rem; animation-delay: 1.3s; animation-duration: 12s;">
            <SvgIcon Name="setting" Size="24" />
        </span>
        <span class="floating-icon absolute inline-flex items-center justify-center opacity-10 text-primary-500 blur-[0.5px] motion-reduce:animate-none motion-reduce:opacity-[0.08]" style="top: 45%; right: 10%; font-size: 1.5rem; animation-delay: 3.5s; animation-duration: 8.5s;">
            <SvgIcon Name="config" Size="24" />
        </span>
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Highlight { get; set; }
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public (string Label, string Href)? PrimaryCta { get; set; }
    [Parameter] public (string Label, string Href)? SecondaryCta { get; set; }
}
